# ==============================================================================
# HS_WSS - HS Tech Web Secret Scanner Configuration
# ==============================================================================
# All configuration parameters are strictly loaded from environment variables.
# Do NOT hardcode credentials, IP addresses or secrets in source code.

# Server Network Binding
HOST=0.0.0.0
PORT=8659

# Application Environment
DEBUG=false
APP_ENV=production

# Persistence (SQLite volume mapped to /opt/hs_wss/data)
DB_PATH=/opt/hs_wss/data/scanner.db
# Reset session data on startup (fresh execution without legacy findings)
PURGE_ON_STARTUP=true

# Crawler Engine Limits
MAX_CRAWL_DEPTH=3
MAX_CRAWL_PAGES=50
PAGE_TIMEOUT_MS=20000
HEADLESS=true
CONCURRENT_PAGES=1

# Network & SSRF Security Controls
BLOCK_METADATA_IPS=true
ALLOWED_SCHEMES=http,https

# Custom User-Agent
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36 HS-WSS/1.0

# Optional custom regex rules file path
CUSTOM_REGEX_FILE=/opt/hs_wss/data/custom_rules.json
